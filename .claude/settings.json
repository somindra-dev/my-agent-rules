{
  "permissions": {
    "allow": [
      "Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git switch:*)",
      "Bash(pytest:*)", "Bash(python3 -m pytest:*)"
    ],
    "ask": [
      "Bash(git push:*)", "Bash(gh pr create:*)", "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)",
      "Bash(git push origin main:*)", "Bash(git tag:*)",
      "Bash(git reset --hard:*)", "Bash(rm -rf:*)",
      "Read(./.env)", "Edit(./.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_force_push.py\""
          }
        ]
      }
    ]
  }
}
